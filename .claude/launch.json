{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tasknado-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/next/dist/bin/next",
        "dev",
        "--hostname",
        "127.0.0.1",
        "--port",
        "3000"
      ],
      "port": 3000,
      "url": "http://127.0.0.1:3000"
    },
    {
      "name": "tasknado-start",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/next/dist/bin/next",
        "start",
        "--hostname",
        "127.0.0.1",
        "--port",
        "3000"
      ],
      "port": 3000,
      "url": "http://127.0.0.1:3000"
    }
  ]
}
