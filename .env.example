NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55431
NEXT_PUBLIC_SUPABASE_ANON_KEY=copy-local-anon-key-from-supabase-status

# Backend workers only. Never expose privileged credentials to NEXT_PUBLIC_.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# TASKNADO_WORKER_TARGET=exact-same-url-as-SUPABASE_URL
# ClamAV daemon (ops/clamav/docker-compose.yml). Loopback unless the network
# path is private and CLAMD_TRUSTED_NETWORK=yes is set on purpose.
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
# CLAMAV_MAX_SIGNATURE_AGE_HOURS=72

# Encrypted Storage backups (scripts/backup-storage.mjs). Paths, never values.
# BACKUP_DIR=/absolute/path/to/an/empty/directory
# BACKUP_KEY_FILE=/absolute/path/outside/the/backup/backup.key
